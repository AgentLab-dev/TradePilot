# Looker Core (Enterprise / looker.com) — REST API 4.0
# Copy to looker.ini in this folder (gitignored) and fill real values.
# Do not invent a URL. There is no instance until you create one.
#
#   cp agents/ssr-st/secrets/looker.ini.example agents/ssr-st/secrets/looker.ini
#
# Keys: Admin → Users → pick a user → Edit Keys / API3 keys
#   client_id + client_secret
# Base URL: the instance host only. No /api/4.0 suffix.
#   GCP Looker Core:  https://<instance>.cloud.looker.com
#   Legacy hosted:    https://<instance>.looker.com:19999
#
# Env alternative (same names looker_sdk reads):
#   LOOKERSDK_BASE_URL  LOOKERSDK_CLIENT_ID  LOOKERSDK_CLIENT_SECRET

[Looker]
base_url=https://YOUR_INSTANCE.cloud.looker.com
client_id=YOUR_API3_CLIENT_ID
client_secret=YOUR_API3_CLIENT_SECRET
verify_ssl=True
