{
  "mcpServers": {
    "snowflake": {
      "command": "python3",
      "args": ["${HOME}/.cursor/skills/mcp-connections/snowflake_mcp_server.py"],
      "env": {
        "SNOWFLAKE_ACCOUNT": "KTAZVPL-EVB32354",
        "SNOWFLAKE_USER": "KOTESWARARAO.VENKATA@WORKDAY.COM",
        "SNOWFLAKE_AUTHENTICATOR": "externalbrowser",
        "SNOWFLAKE_ROLE": "ROLE_ANALYTICS_ENGINEER",
        "SNOWFLAKE_WAREHOUSE": "ANALYTICS_ENGINEER_WH",
        "SNOWFLAKE_DATABASE": "CERTIFIED_DEV",
        "SNOWFLAKE_SCHEMA": "FINANCE"
      }
    },
    "dbt": {
      "command": "${HOME}/.local/bin/uvx",
      "args": ["dbt-mcp"],
      "env": {
        "DBT_PROJECT_DIR": "__REPLACE_WITH_PROJECT_DIR__",
        "DBT_PATH": "${HOME}/Library/Python/3.13/bin/dbt"
      }
    },
    "salesforce": {
      "command": "/opt/homebrew/bin/sf-mcp-server",
      "args": [
        "--orgs=[REDACTED_EMAIL]",
        "--toolsets=data",
        "--no-telemetry"
      ],
      "env": {}
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "sigma": {
      "command": "npx",
      "args": ["-y", "@getguru/sigma-mcp"],
      "env": {}
    }
  }
}
